{
  "baseUrl": "${DEPLOY_URL}",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "say": "Open PayPulse",
      "goto": "/"
    },
    {
      "say": "Get started and open the dashboard",
      "click": "[data-demo='launch-demo']",
      "waitFor": "[data-demo='list']"
    },
    {
      "say": "Add a new invoice",
      "click": "[data-demo='new']",
      "waitFor": "[data-demo='title']"
    },
    {
      "say": "Enter the customer and submit",
      "fill": {
        "[data-demo='title']": "Kazi Logistics Ltd"
      },
      "click": "[data-demo='submit']",
      "waitFor": "[data-demo='row']"
    }
  ]
}
